# Copie pra secrets.toml (que é ignorado pelo git) e preencha com as
# credenciais reais. Local: .streamlit/secrets.toml
# No Streamlit Cloud: Settings > Secrets do app, mesmo formato.

RODONAVES_API_USERNAME = ""
RODONAVES_API_PASSWORD = ""

# Expresso São Miguel - até 3 pares Customer/Access_Key, um por CNPJ do
# grupo Sebem que despacha por essa transportadora. Deixa os que não tiver
# em branco (o app pula os pares incompletos).
SAO_MIGUEL_CUSTOMER_1 = ""
SAO_MIGUEL_ACCESS_KEY_1 = ""

SAO_MIGUEL_CUSTOMER_2 = ""
SAO_MIGUEL_ACCESS_KEY_2 = ""

SAO_MIGUEL_CUSTOMER_3 = ""
SAO_MIGUEL_ACCESS_KEY_3 = ""
